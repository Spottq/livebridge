<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#B3576D84"
                android:endColor="#A645566B" />
            <stroke
                android:width="1dp"
                android:color="#2AFFFFFF" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3DF6FBFF"
                android:endColor="#06F6FBFF" />
        </shape>
    </item>
</layer-list>
