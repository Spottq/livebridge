<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/flashlight_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFF5F7FA"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/flashlight_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFB8C0CC"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/flashlight_action_button"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_flashlight_action_button"
        android:gravity="center"
        android:textColor="#FFF5F7FA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/flashlight_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FF6B7280"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
