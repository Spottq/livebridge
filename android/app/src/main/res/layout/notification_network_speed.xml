<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/network_speed_notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/network_speed_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFF5F7FA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/network_speed_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFF5F7FA"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/network_speed_wifi_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_network_usage_wifi" />

        <TextView
            android:id="@+id/network_speed_wifi_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF5F7FA"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/network_speed_mobile_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_network_usage_mobile" />

        <TextView
            android:id="@+id/network_speed_mobile_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF5F7FA"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
